{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edutech",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "EMIA_KV",
      "id": "2b7d2b314e0149ccb1446573515203b9"
    }
  ]
}